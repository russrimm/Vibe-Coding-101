# Copy to .env.local for local testing. These values are PUBLIC: they are
# built into the browser bundle. Never put secrets or API keys here.

# Public https booking page that collects payment (Cal.com, Calendly, etc.).
# Leave empty to show "Online booking is not open yet".
VITE_COACHING_BOOKING_URL=

# Display-only price label. The booking provider's checkout is authoritative.
# Example: $49 USD
VITE_COACHING_PRICE=

# Session length in minutes (15-240). Defaults to 60.
VITE_COACHING_DURATION_MINUTES=60
